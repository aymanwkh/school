@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<div id="app">
    <v-container fluid>
            
        <v-toolbar title="Student Information Registration"> 
            <template v-slot:append>
          <v-btn icon="mdi-magnify" @@click="showDialog"></v-btn>
          <v-icon-btn icon="mdi-dots-vertical" :active="menu">
            <v-icon></v-icon>
            <v-menu v-model="menu" activator="parent" location="bottom end" offset="4">
          <v-list
            bg-color="surface-light"
            class="d-flex flex-column ga-1 pa-1"
            density="compact"
            rounded="lg"
            variant="text"
            slim
          >
            <v-list-item
              append-icon="mdi-account-circle-outline"
              rounded="lg"
              title="Account"
              link
            ></v-list-item>

            <v-list-item
              prepend-icon="mdi-cog-outline"
              rounded="lg"
              title="Settings"
              link
            ></v-list-item>

            <v-list-item
              prepend-icon="mdi-logout-variant"
              rounded="lg"
              title="Logout"
              link
            ></v-list-item>
          </v-list>
        </v-menu>
          </v-icon-btn>
      </template>
        </v-toolbar>
<v-row>
<v-col md="6" class="bg-purple-darken-2">

  <v-card max-width="400" variant="flat">
    <v-list lines="one" density="comfortable">
      
      <v-list-item class="border-b">
        <!-- Label on the left -->
        <v-list-item-title class="text-body-2 text-medium-emphasis">
          Status
        </v-list-item-title>

        <!-- Value on the right using the append slot -->
        <template #append>
          <v-chip color="success" size="small" label>Active</v-chip>
        </template>
      </v-list-item>

      <v-list-item class="border-b">
        <v-list-item-title class="text-body-2 text-medium-emphasis">
          Created By
        </v-list-item-title>

        <template #append>
          <span class="text-body-2 text-high-emphasis font-weight-medium">
            Alex Johnson
          </span>
        </template>
      </v-list-item>

    </v-list>
  </v-card>
</v-col>
<v-col md="6">

  <v-card max-width="400" variant="flat">
    <v-list lines="one" density="comfortable">
      
      <v-list-item class="border-b">
        <!-- Label on the left -->
        <v-list-item-title class="text-body-2 text-medium-emphasis">
          Status
        </v-list-item-title>

        <!-- Value on the right using the append slot -->
        <template #append>
          <v-chip color="success" size="small" label>Active</v-chip>
        </template>
      </v-list-item>

      <v-list-item class="border-b">
        <v-list-item-title class="text-body-2 text-medium-emphasis">
          Created By
        </v-list-item-title>

        <template #append>
          <span class="text-body-2 text-high-emphasis font-weight-medium">
            Alex Johnson
          </span>
        </template>
      </v-list-item>

    </v-list>
  </v-card>
</v-col>
</v-row>


                <v-dialog v-model="dialog" max-width="400">
      <v-card>
        <v-card-text>
          <!-- Input Field -->
<form @@submit.prevent="submit">
          <v-text-field
            v-model="inputValue"
            label="بحث بالرقم"
            variant="filled"
:append-icon="'mdi-text-search-variant'"
          ></v-text-field>
  </form>

          <!-- Button Beneath It -->
          <v-btn
            color="primary"
            block
            class="mt-3"
            @@click="handleSubmit"
          >
            بحث متقدم
          </v-btn>
        </v-card-text>

      </v-card>
    </v-dialog>

    </v-container>
</div>
@section Scripts {

    <script>
        const { ref, reactive } = Vue
        function setup() {
            const menu = ref(false)
            const form = ref(null)
            const isFormValid = ref(false)

            // Form Fields Structure
            const student = reactive({
                id: '',
                name: '',
                birthDate: '',
                birthPlace: '',
                parentId: '',
                nationality: '',
                address: '',
                classNumber: null,
                gender: null,
                healthStatus: 'None',
                notes: '',
                mobileNumber: '',
                familyOrder: null
            })

            // Options for Class selection list
            const classOptions = ref([
                'Class 101', 'Class 102', 'Class 103',
                'Class 201', 'Class 202', 'Class 301'
            ])

            // Basic validation rules setup
            const rules = {
                required: v => !!v || 'This field is required.',
                positiveNumber: v => (v && v > 0) || 'Value must be greater than 0.',
                phone: v => {
                    const pattern = /^\+?[0-9\s-]{7,15}$/
                    return pattern.test(v) || 'Invalid phone number format.'
                }
            }

            // Actions
            const submitForm = async () => {
                if (!form.value) return
  
                const { valid } = await form.value.validate()
  
                if (valid) {
                    // Process form payload data safely
                    console.log('Student Info Payload Submitted:', JSON.stringify(student, null, 2))
                    alert('Student registration payload logged to console!')
                }
            }

            const resetForm = () => {
                if (form.value) {
                    form.value.reset()
                    // Reset default fallback options explicitly if needed
                    student.healthStatus = 'None'
                }
            }
            const dialog = ref(false)
const inputValue = ref('')

const handleSubmit = () => {
  console.log('Submitted value:', inputValue.value)
  dialog.value = false
}
function submit() {
    console.log('submitted....')
}
const items = [
    { text: 'My Files', icon: 'mdi-folder' },
    { text: 'Shared with me', icon: 'mdi-account-multiple' },
    { text: 'Starred', icon: 'mdi-star' },
    { text: 'Recent', icon: 'mdi-history' },
    { text: 'Offline', icon: 'mdi-check-circle' },
    { text: 'Uploads', icon: 'mdi-upload' },
    { text: 'Backups', icon: 'mdi-cloud-upload' },
  ]
            return {
                form, isFormValid, student, classOptions,
                resetForm, submitForm, rules, dialog, inputValue,
                handleSubmit, submit, menu, items
            }
        }
        // Form Ref and state
    </script>
}

