<v-container fluid>
    <page-title title="معلومات صفحة" save></page-title>
    <v-row density="compact">
        <v-col cols="12">
          <v-text-field
            v-model="page.name"
            :counter="10"
            :rules="nameRules"
            label="الاسم"
            required
          ></v-text-field>
        </v-col>
        <v-col cols="12">
          <v-text-field
            v-model="page.path"
            :rules="pathRules"
            label="المسار"
            required
          ></v-text-field>
        </v-col>
    </v-row>
</v-container>
@section Scripts {
    <script>
        const fullPath = window.location.href
        const lastSlashIndex = fullPath.lastIndexOf('/')
        const id = fullPath.substring(lastSlashIndex + 1)
        const page = ref({
            id: 0,
            name: '',
            path: ''
        })
        const nameRules = [
            @* value => {
            if (value) return true

            return 'Name is required.'
            }, *@
            value => {
            if (value?.length <= 10) return true

            return 'Name must be less than 10 characters.'
            },
        ]
        const pathRules = [
            value => {
            if (value) return true

            return 'Path is required.'
            },
        ]
        function main() {

            onMounted(async () => {
                if (typeof id !== 'number' || id == 0) return
                const response = await fetch('/home/getPageInfo/' + id)
                page.value = await response.json()
            })
            return { page, nameRules, pathRules }
        }
    </script>
}
