<v-container fluid>
    <v-form @@submit.prevent="submit">
    <page-title title="معلومات صفحة" save :loading="loading"></page-title>
    <v-row density="compact">
        <v-col cols="12">
          <v-text-field
            v-model="page.name"
            :counter="10"
            :rules="nameRules"
            label="الاسم"
          ></v-text-field>
        </v-col>
        <v-col cols="12">
          <v-text-field
            v-model="page.path"
            :rules="pathRules"
            label="المسار"
          ></v-text-field>
        </v-col>
    </v-row>
    </v-form>
</v-container>
@section Scripts {
    <script>
        const fullPath = window.location.href
        const lastSlashIndex = fullPath.lastIndexOf('/')
        const id = fullPath.substring(lastSlashIndex + 1)
        const loading = ref(false)
        const page = ref({
            id: 0,
            name: '',
            path: ''
        })
        const nameRules = [
            value => {
            if (value) return true

            return 'Name is required.'
            },
            value => {
            if (value?.length <= 10) return true

            return 'Name must be less than 10 characters.'
            },
        ]
        const pathRules = [
            value => {
            if (value) return true

            return 'Path is required.'
            },
        ]
        async function submit(event) {
            const results = await event
            if (results.valid) {
                loading.value = true
                const response = await fetch('/home/editPage', {
                    method: 'POST', // Specify the method
                    headers: {
                        'Content-Type': 'application/json', // Indicate the content type
                    },
                    body: JSON.stringify(page.value), // Convert the data to a JSON string
                })
                loading.value = false
                console.log('resp == ', response)
                if (response.redirected) window.location.href = response.url
            }

        }
        function main() {
            onMounted(async () => {
                if (!Number.isFinite(Number(id)) || id == 0) return
                const response = await fetch('/home/getPageInfo/' + id)
                page.value = await response.json()
            })
            return { page, nameRules, pathRules, submit, loading }
        }
    </script>
}
